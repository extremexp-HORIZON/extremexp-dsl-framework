package std;

workflow w2 from w1{
	// configure tasks and data from w1
	configure data d1 {
		schema "some-new.csv";
	}
	
	configure task t1 {
		// implementation should be first line
		implementation w3;
		
		// this is where it gets confusing because t1 exists in both w1 and w3
		configure task t1 {
			configure task t3 {
				
			}
		}
		param w = 33;
		param ww = -33;
		param s = "some string";
		param f = x;
		param k = pw3;
	}
	param x = 11;

}