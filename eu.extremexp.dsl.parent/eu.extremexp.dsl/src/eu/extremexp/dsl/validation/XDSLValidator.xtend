class XDSLValidator extends AbstractXDSLValidator {
	
	// we don't want to create a cycle reference for assembled workflow
	public static val INVALID_REFERENCE = 'invalidReference'
	
	@Check
	def checkAcyclicWorkflowReference(AssembledWorkflow assembledWorkflow){
		var parents = newHashMap()
		var currentParrent = assembledWorkflow.parent
		while (currentParrent instanceof AssembledWorkflow){
	 		if (parents.containsKey(currentParrent)){
	 			error("There exist a cyclic reference to the same workflow", 
					XDSLPackage.Literals.ASSEMBLED_WORKFLOW__PARENT,
					INVALID_REFERENCE)	
				return
	 		}
	 		parents.put(currentParrent, 1)
	 		currentParrent = currentParrent.parent
	 	}

	}
	
