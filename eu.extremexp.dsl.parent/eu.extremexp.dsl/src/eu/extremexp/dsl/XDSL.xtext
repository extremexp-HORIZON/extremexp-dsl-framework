grammar eu.extremexp.dsl.XDSL with org.eclipse.xtext.common.Terminals

generate xDSL "http://www.extremexp.eu/dsl/XDSL"

Root:
	isPacakge?=ExperimentPackage | isTask?=TaskPackage
;

ExperimentPackage:
	('package' name=ID ';')?
	components += Component+
;

Component:
	Workflow | AssembledWorkflow |  Experiment
;

Workflow:
    'workflow' name=ID '{'
       	(
       		tasks += Task				|
       		data += Data				|
       		operators += Operator		|	
       		dataConfigs += DataConfig	|
       		taskConfigs += TaskConfig	|
       		nodeLinks += NodeLink		|
       		dataLinks += DataLink
       	)*
    '}'
;

Task:
	'define' 'task' name=ID ';'
;


Data: 
	'define' (output?='output'|input?='input')? 'data' name=ID
	(assigned?=
		'['
		 'data'	'=' values+=Value (',' values+=Value)+	
		']')? 
	';'
;

Value:
	STRING | INT | FLOAT | BOOL | NULL | ENUM | Range
;

terminal FLOAT:
	INT'.'INT
;

terminal BOOL:
	'True'|'False'
;

terminal NULL:
	'null'
;

Text:
	INT | STRING
;

ENUM:
    'enum''(' values+=Text (',' values+=Text)* ')'
;

Range:
	'range' '(' minimum=INT ',' maximum=INT (',' step=INT )? ')'
;
Operator:
	'define' 'operator' name=ID ';'
;


DataConfig:
	'configure' 'data' alias=[Data|ID] '{'
		'path' path=STRING ';'
	'}'
;

TaskConfig:
    'configure' 'task' alias=[Task|ID] '{'
        (
        	params += Param |
        	implementations += Implementation	|
        	dependencies += Dependency	|
        	subTaskConfigs += TaskConfig
        )*
    '}'
 ;

Param:
 	'param' name=ID (assinged?='=' (value=Value | otherParam=[Param]))? ';'
 ;
 
Implementation:
 	'implementation' (workflow=[Workflow]|filename=STRING) ';'
 ;
 
Dependency:
 	'dependency' dependency=STRING ';'
 ;
Node:
	{Operator} | {Task}
;


NodeLink:
	(started?='START' '->')?  
	nodes+=[Node] ('->' nodes+=[Node])* 
	(ended?='->' 'END')? ';'
;

QualifiedData:
	node=[Node]'.'data=[Data]
;

Element:
	 {Node} | {Data} 
;



DataLink:
    (initialQualifiedData = QualifiedData | initialElement = [Element]  ) 
    ('-->' 	(restElements += [Element] | restQualifiedElements+= QualifiedData) )+ ';'
;


//ConditionLink: 
//	fromNode=[Node] '->' condition=STRING '?' trueNode=[Node]  ':' falseNode=[Node] '->' continuationNode=[Node] ';'

GroupTask:  'group' name=ID '{' node+=[Node]* '}' ';' ;


AssembledWorkflow:
    'workflow' name=ID 'from' parentWorkflow=[Workflow] '{'
        taskConfigs+=TaskConfig*
    '}'
;


Experiment:
    'experiment' name=ID '{'
    	('intent' intent=ID ';')?
    	(control=Control)?
        (
        	spaces += Space 	|
        	events += Event
        )* 
    '}'
;

EventType: 
	'automated' | 'manual'
;

Event:
	'event' name=ID '{'
	    'type' eventType=EventType ';'
	    ('condition' condition=STRING ';')?
	    'task' validation_task=STRING ';'
	    ('restart' restart=BOOL ';')?
	'}'
;

Space:
    'space' name=ID 'of' assembled_workflow=[AssembledWorkflow] '{'
        'strategy' strategy_name=Strategy ';'
        (
        	params+=Param	|
        	tasks+=TaskConfig
        )*
        
    '}';

Strategy: 
	{Strategy} ('gridsearch' |  'randomsearch' ('runs' '=' runs=INT)?)
;


Control:
        {Control} 'control' '{'
               expLink+=ExpLink*
        '}';


ExpLink:  RegularExpLink | ConditionalExpLink;

ExpNode:
	{Space} | {Event}
;

RegularExpLink:
	(started?='START' '->')?  
	nodes+=[ExpNode] ('->' nodes+=[ExpNode])* 
	(ended?='->' 'END')? ';'
;


ConditionalExpLink:
    fromNode=[ExpNode] '?->' toNode=[ExpNode] '{' 'condition' condition=STRING '}' ';'
;

TaskPackage:
	'task' name=ID '{'
        elements+=TaskElement*
    '}'
;

TaskElement:  
	Data | Implementation | Parameter
;

Parameter:
    'param' name=ID '{'
        'type' type=ID ';'
        'default' default=INT ';'
        range=Range ';'
    '}';