grammar eu.extremexp.dsl.XDSL with org.eclipse.xtext.common.Terminals

generate xDSL "http://www.extremexp.eu/dsl/XDSL"

Root:
	'package' name=ID ';'
	workflows += Workflow*
	
;

// workflow is an abstract class that can be extended by the following classes
Workflow:
	CompositeWorkflow | TaskSpecification | AssembledWorflow
;



CompositeWorkflow:
	'workflow' name=ID '{'
		(
			// shared members (i.e. super members)
			inputs += InputData			|
			outputs += OutputData		| 
			
			// dedicated members
			links += Link				|
			nodes += Node
		)*
	'}'
;

AssembledWorflow:
	'workflow' name=ID 'from' parent=[Workflow] '{'
		(
			// shared members (i.e. super members)
			inputs += InputData			|
			outputs += OutputData 		|
			
			// dedicated members
			substitutedTask += SubstitutedTask
		)*
	'}'
;

TaskSpecification:
	'task' name=ID '{'
		(
			// shared members (i.e. super members)
			inputs += InputData			|
			outputs += OutputData 
		)*
	'}'
;

Node:
	Task | Event 
;



// Data
InputData:
	'define' 'input' 'data' name=ID ';' 
;

OutputData:
	'define' 'output' 'data' name=ID ';' 
;


// Task
SubstitutedTask:
	'configure' task=Task
;

Task:
	(abstract?= 'define' 'task' name=ID ';')
	|
	// TODO if a task is directly configured without given name, should we allow it?
	('configure' 'task' task=[Task|ID] '{'
		(
			// shared members (i.e. super members)
			inputs += InputData			|
			outputs += OutputData 		|	
			
			// special members
			metadata += MetaData		|
			
			// single members
			'description' description=STRING ';'		|
			'implementation' primitiveImplementation=STRING ';'		

		)*
		
	'}')
;

MetaData:
	'metadata''{' name=STRING ':' value=STRING '}' ';'
;

// Event
Event:
	eventValue=EventValue	
;

enum EventValue:
	START='START' | END='END'
;


// Operator
Operator:
	Join | Parallel  | Exclusive | Inclusive 
;


terminal JOIN_TERM:
	'JOIN-'INT
;

terminal PARALLEL_TERM:
	'PARALLEL-'INT
;

terminal EXCLUSIVE_TERM:
	'EXCLUSIVE-'INT
;

terminal INCLUSIVE_TERM:
	'INCLUSIVE-'INT
;

Join :
    id=JOIN_TERM
 ;

Parallel :
	id=PARALLEL_TERM
;
Exclusive :
	id=EXCLUSIVE_TERM  
;

Inclusive :
	id=INCLUSIVE_TERM 
;


// Link
Link:
	ConditionalLink | RegularLink | ExceptionalLink
;


ConditionalLink:
	input=[Node] '?->' output=[Node] '{'
		(
			"condition" condition=STRING ';'	|
			"cases" cases+=Case+ 
		)
	'}'
;

RegularLink:
	input=[Node] '->' output=[Node] ';'
;

ExceptionalLink:
	input=[Node] '!->' output=[Node] '{'
		"event" event=STRING ';'
	'}'
;

Case: 
	case=STRING target=[Node] ';'
;